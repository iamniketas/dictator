{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iamniketas/dictator/shared/contracts/runtime/model_catalog.v1.json",
  "title": "Model Catalog Contract v1",
  "description": "Canonical list of supported transcription models and compatibility metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_version", "updated_at", "models"],
  "properties": {
    "schema_version": {
      "const": "model_catalog.v1"
    },
    "catalog_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "family",
          "display_name",
          "source",
          "size_bytes",
          "quality_profile",
          "speed_profile",
          "supported_backends",
          "recommended_tiers"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "family": {
            "type": "string",
            "enum": ["whisper_ggml", "faster_whisper", "whisperkit", "parakeet", "other"]
          },
          "display_name": { "type": "string", "minLength": 1 },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "uri"],
            "properties": {
              "type": { "type": "string", "enum": ["huggingface", "github_release", "custom"] },
              "uri": { "type": "string" },
              "sha256": {
                "type": "string",
                "pattern": "^[A-Fa-f0-9]{64}$"
              }
            }
          },
          "size_bytes": { "type": "integer", "minimum": 1 },
          "quality_profile": { "type": "string", "enum": ["high", "balanced", "fast"] },
          "speed_profile": { "type": "string", "enum": ["slow", "balanced", "fast"] },
          "supported_backends": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": ["embedded_whisper_rs", "faster_whisper", "whisperkit", "server"]
            }
          },
          "recommended_tiers": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            }
          },
          "min_requirements": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ram_mb": { "type": "integer", "minimum": 1 },
              "vram_mb": { "type": "integer", "minimum": 0 },
              "accelerator": {
                "type": "string",
                "enum": ["none", "cuda", "metal", "directml"]
              }
            }
          },
          "languages": {
            "type": "array",
            "items": { "type": "string" }
          },
          "deprecated": { "type": "boolean", "default": false }
        }
      }
    }
  }
}
