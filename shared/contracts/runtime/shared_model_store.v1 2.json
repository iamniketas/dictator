{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iamniketas/dictator/shared/contracts/runtime/shared_model_store.v1.json",
  "title": "Shared Model Store Contract v1",
  "description": "State file for installed runtimes and models shared across Dictator and Contora.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "store_version",
    "models_root_path",
    "installed_runtimes",
    "installed_models"
  ],
  "properties": {
    "schema_version": {
      "const": "shared_model_store.v1"
    },
    "store_version": {
      "type": "integer",
      "minimum": 1
    },
    "models_root_path": {
      "type": "string",
      "minLength": 1
    },
    "active_runtime_id": {
      "type": ["string", "null"]
    },
    "active_model_id": {
      "type": ["string", "null"]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_by": {
      "type": "string",
      "enum": ["dictator", "contora", "manual", "unknown"],
      "default": "unknown"
    },
    "installed_runtimes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "display_name", "kind", "entry_path"],
        "properties": {
          "id": { "type": "string" },
          "display_name": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["whisper_rs", "faster_whisper", "whisperkit", "other"]
          },
          "version": { "type": "string" },
          "entry_path": { "type": "string" },
          "disk_usage_bytes": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "installed_models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "runtime_id", "directory_path", "health"],
        "properties": {
          "id": { "type": "string" },
          "runtime_id": { "type": "string" },
          "directory_path": { "type": "string" },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "is_default": { "type": "boolean", "default": false },
          "health": {
            "type": "string",
            "enum": ["ok", "missing_files", "corrupted", "unknown"]
          },
          "required_files": {
            "type": "array",
            "items": { "type": "string" }
          },
          "registered_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "locks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "owner", "acquired_at"],
        "properties": {
          "name": { "type": "string" },
          "owner": { "type": "string" },
          "acquired_at": { "type": "string", "format": "date-time" },
          "expires_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
