{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iamniketas/dictator/shared/contracts/config.schema.json",
  "title": "Dictator Cross-Platform Config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hotkey",
    "audio",
    "whisper",
    "ollama"
  ],
  "properties": {
    "hotkey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modifiers",
        "key"
      ],
      "properties": {
        "modifiers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "ctrl",
              "shift",
              "alt",
              "cmd"
            ]
          }
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_rate"
      ],
      "properties": {
        "device": {
          "type": [
            "string",
            "null"
          ]
        },
        "sample_rate": {
          "type": "integer",
          "minimum": 8000,
          "maximum": 192000
        }
      }
    },
    "whisper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_path",
        "language"
      ],
      "properties": {
        "model_path": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 8
        }
      }
    },
    "ollama": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "url",
        "model"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "model": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "streaming": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "poll_interval"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "poll_interval": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        }
      }
    }
  }
}
