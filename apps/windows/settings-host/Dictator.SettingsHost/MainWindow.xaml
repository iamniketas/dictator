<Window
    x:Class="Dictator.SettingsHost.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Dictator Settings">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <NavigationView x:Name="Nav"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Left"
                        OpenPaneLength="220"
                        SelectionChanged="OnNavChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Welcome" Tag="welcome"><NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Models" Tag="models"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Runtime &amp; Device" Tag="runtime"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Dictation" Tag="dictation"><NavigationViewItem.Icon><FontIcon Glyph="&#xE720;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Storage" Tag="storage"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="About" Tag="about"><NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.MenuItems>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,18,24,24">
                <StackPanel Spacing="18">
                    <TextBlock x:Name="PageTitle" FontSize="28" FontWeight="SemiBold" Text="Models" />

                    <StackPanel x:Name="WelcomePanel" Spacing="14" Visibility="Collapsed">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                            <StackPanel Spacing="14">
                                <TextBlock Text="Welcome to Dictator" FontSize="24" FontWeight="SemiBold" />
                                <TextBlock Text="Local voice dictation for desktop apps. Press hotkey, speak, release, text is inserted into active field." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE70F;" FontSize="18" />
                                    <TextBlock Grid.Column="1" Text="1) Open Models, download one model and activate it." TextWrapping="Wrap" />
                                </Grid>

                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE765;" FontSize="18" />
                                    <TextBlock Grid.Column="1" Text="2) Open Runtime &amp; Device and keep Auto mode (recommended)." TextWrapping="Wrap" />
                                </Grid>

                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE720;" FontSize="18" />
                                    <TextBlock Grid.Column="1" Text="3) Press Right Ctrl to start/stop dictation and test insertion in any text field." TextWrapping="Wrap" />
                                </Grid>

                                <Border Background="{ThemeResource AccentFillColorSecondaryBrush}" CornerRadius="10" Padding="10">
                                    <TextBlock Text="Tip: closing this window does not stop Dictator. Use tray icon -> Exit to fully close app." TextWrapping="Wrap" />
                                </Border>

                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="10">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Current Setup" FontWeight="SemiBold" />
                                        <TextBlock x:Name="WelcomeModelStatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        <TextBlock x:Name="WelcomeRuntimeStatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        <TextBlock x:Name="WelcomeHotkeyStatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Open Models" Click="OnGoToModelsClick" />
                                    <Button Content="Open Runtime" Click="OnGoToRuntimeClick" />
                                    <Button Content="Open Dictation" Click="OnGoToDictationClick" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="ModelsPanel" Spacing="14">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Model Catalog" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Download a model, then activate it by clicking its card. You can delete installed models at any time." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <ItemsControl x:Name="CatalogItems">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="12"
                                                    CornerRadius="10"
                                                    BorderThickness="1"
                                                    Margin="0,0,0,10"
                                                    Background="{Binding CardBackground}"
                                                    BorderBrush="{Binding CardBorderBrush}"
                                                    Tapped="OnCatalogCardTapped">
                                                <Grid RowSpacing="10">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid ColumnSpacing="14">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="170" />
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Spacing="5">
                                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding StateLabel}" Foreground="{Binding StateBrush}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <TextBlock Text="{Binding StatsLine}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <TextBlock Text="{Binding LanguageLine}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <TextBlock Text="{Binding RuntimeLine}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Top" HorizontalAlignment="Right" Width="170">
                                                            <Button Width="136" HorizontalAlignment="Right" Content="Download"
                                                                    Tag="{Binding Id}"
                                                                    Click="OnCatalogDownloadClick"
                                                                    Visibility="{Binding DownloadVisibility}"
                                                                    IsEnabled="{Binding DownloadEnabled}" />
                                                            <Button Width="136" HorizontalAlignment="Right" Content="Stop"
                                                                    Tag="{Binding Id}"
                                                                    Click="OnCatalogCancelClick"
                                                                    Visibility="{Binding CancelVisibility}"
                                                                    IsEnabled="{Binding CancelEnabled}" />
                                                            <Button Width="136" HorizontalAlignment="Right" Content="Delete"
                                                                    Tag="{Binding Id}"
                                                                    Click="OnCatalogDeleteClick"
                                                                    Visibility="{Binding DeleteVisibility}"
                                                                    IsEnabled="{Binding DeleteEnabled}" />
                                                            <Button Width="136" HorizontalAlignment="Right" Content="{Binding ExternalActionLabel}"
                                                                    Tag="{Binding Id}"
                                                                    Click="OnCatalogExternalClick"
                                                                    Visibility="{Binding ExternalActionVisibility}"
                                                                    IsEnabled="{Binding ExternalActionEnabled}" />
                                                            <TextBlock Text="{Binding SizeLine}"
                                                                       HorizontalAlignment="Right" TextAlignment="Right"
                                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <StackPanel Grid.Row="1" Visibility="{Binding ProgressVisibility}">
                                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding DownloadProgress}" Height="6" />
                                                        <TextBlock Text="{Binding DownloadStatusText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,6,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="RuntimePanel" Spacing="14" Visibility="Collapsed">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Runtime mode" FontSize="16" FontWeight="SemiBold" />
                                <ComboBox x:Name="RuntimeModeCombo" SelectionChanged="OnRuntimeChanged">
                                    <ComboBoxItem Content="Auto (Recommended)" Tag="auto" />
                                    <ComboBoxItem Content="Force GPU" Tag="force_gpu" />
                                    <ComboBoxItem Content="Force CPU" Tag="force_cpu" />
                                </ComboBox>
                                <TextBlock x:Name="RuntimeSummary" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Hardware Diagnostics" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock x:Name="HardwareScoreValue" FontSize="42" FontWeight="SemiBold" />
                                <TextBlock x:Name="HardwareScoreHint" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="HardwareCpuText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="HardwareGpuText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="HardwareRamText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="HardwareRecommendationText" TextWrapping="Wrap" />
                                <TextBlock x:Name="RuntimeModelRecommendations" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="DictationPanel" Spacing="14" Visibility="Collapsed">
                        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Dictation Profile" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock x:Name="DictationProfileSummaryText" TextWrapping="Wrap" />
                                <TextBlock x:Name="DictationLatencyHintText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="DictationQualityHintText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Transcription Mode" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Choose between lower-latency streaming and higher-stability full transcription." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <ToggleSwitch x:Name="StreamingToggle" Header="Enable streaming transcription" Toggled="OnStreamingToggled" />
                                <NumberBox x:Name="ChunkSecondsBox" Header="Streaming chunk interval (seconds)" Minimum="3" Maximum="60" ValueChanged="OnChunkValueChanged" />
                                <TextBlock x:Name="ChunkHintText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="Hotkey: Right Ctrl (hold/tap behavior managed by app runtime)." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Injection" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="How recognized text is inserted into the target app." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <ComboBox x:Name="InjectionCombo" SelectionChanged="OnInjectionChanged">
                                    <ComboBoxItem Content="Direct (SendInput)" Tag="direct" />
                                    <ComboBoxItem Content="Clipboard (Ctrl+V)" Tag="clipboard" />
                                    <ComboBoxItem Content="Clipboard + Enter" Tag="clipboard_enter" />
                                </ComboBox>
                                <TextBlock x:Name="InjectionHintText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Post-processing (Ollama)" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Optional text cleanup after transcription. Improves readability, adds latency." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <ToggleSwitch x:Name="LlmToggle" Header="Enable Ollama correction" Toggled="OnLlmToggled" />
                                <TextBox x:Name="OllamaUrlBox" Header="Ollama URL" LostFocus="OnConfigFieldLostFocus" />
                                <TextBox x:Name="OllamaModelBox" Header="Ollama model" LostFocus="OnConfigFieldLostFocus" />
                                <NumberBox x:Name="IdleMinutesBox" Header="Idle unload (minutes)" Minimum="1" Maximum="240" ValueChanged="OnIdleValueChanged" />
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Overlay Feedback" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Controls post-transcription confirmation panel shown near cursor." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <ToggleSwitch x:Name="PostOverlayToggle" Header="Show post-transcription summary overlay" Toggled="OnPostOverlayToggled" />
                                <NumberBox x:Name="PostOverlaySecondsBox" Header="Summary overlay duration (seconds)" Minimum="1" Maximum="15" ValueChanged="OnPostOverlaySecondsChanged" />
                                <TextBlock x:Name="OverlayHintText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="StoragePanel" Spacing="14" Visibility="Collapsed">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Models Folder" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="All local transcription models are stored here." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="ModelsPathText" TextWrapping="Wrap" />
                                <TextBlock x:Name="ModelsSizeText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Open" Click="OnOpenModelsFolder" />
                                    <Button Content="Change" Click="OnChangeModelsFolder" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Audio History Folder" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Saved WAV recordings." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="AudioPathText" TextWrapping="Wrap" />
                                <TextBlock x:Name="AudioSizeText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Open" Click="OnOpenAudioFolder" />
                                    <Button Content="Change" Click="OnChangeAudioFolder" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Transcripts Folder" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Saved transcription text files." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="TranscriptsPathText" TextWrapping="Wrap" />
                                <TextBlock x:Name="TranscriptsSizeText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Open" Click="OnOpenTranscriptsFolder" />
                                    <Button Content="Change" Click="OnChangeTranscriptsFolder" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="AboutPanel" Spacing="14" Visibility="Collapsed">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock x:Name="AboutText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Button Content="Close" HorizontalAlignment="Left" Click="OnClose" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Window>







